# Local, single-user instance. Copy to upstream/backend/.env and set the two data paths.
# Not for an Internet-facing deployment (DEBUG on, no HTTPS settings).
DEBUG=True
DJANGO_ENV=development
SECRET_KEY=local-dev-only-not-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
ADMIN_NOTIFICATION_EMAIL=

# Farm data outside the code checkout (decision 0004). Absolute paths, local disk only.
SQLITE_PATH=/home/<user>/Projekte/OpenFarmPlanner/data/db.sqlite3
MEDIA_ROOT=/home/<user>/Projekte/OpenFarmPlanner/data/media
